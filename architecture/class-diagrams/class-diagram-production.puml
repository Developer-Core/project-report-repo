@startuml class-diagram-production
!pragma layout smetana

' Producción Bounded Context — Class Diagram
' Trazabilidad: HU22 Etapas, HU23 Update etapa, HU24 Progreso, HU25 Tiempos,
' HU31 Tiempo total, TS03 PATCH /orders/{id}/stages/{id}

title Produccion Bounded Context — Class Diagram

scale 0.7
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam dpi 90
skinparam defaultFontSize 11
skinparam classAttributeFontSize 10
skinparam classFontSize 12
skinparam packageFontSize 12
skinparam nodesep 20
skinparam ranksep 30
hide empty members

package "Produccion Bounded Context" as produccion {

    package "Domain" as produccion_domain {

        enum StageStatus <<enumeration>> {
            PENDING
            IN_PROGRESS
            COMPLETED
        }

        enum StageName <<enumeration>> {
            DISENO
            CORTE
            ENSAMBLADO
            ACABADO
            ENTREGA
        }

        class ManufactureOrder <<resource>> {
            - id: Number|null
            - orderId: Number|null
            - startedAt: Date|null
            - finishedAt: Date|null
            - totalEstimatedHours: Number
            + constructor(id, orderId, startedAt, finishedAt, totalEstimatedHours)
            + progressPercent(): Number
            + estimatedDeliveryDate(): Date
        }

        class Stage <<resource>> {
            - id: Number|null
            - manufactureOrderId: Number|null
            - name: StageName
            - sequence: Number
            - status: StageStatus
            - estimatedHours: Number
            - startedAt: Date|null
            - completedAt: Date|null
            + constructor(id, manufactureOrderId, name, sequence, status, estimatedHours, startedAt, completedAt)
            + isCompleted(): boolean
        }

        class StagePhoto <<value-object>> {
            - url: string
            - caption: string|null
            - uploadedAt: Date
            + constructor(url, caption, uploadedAt)
        }

        class MaterialConsumption <<value-object>> {
            - materialId: Number
            - quantity: Number
            - consumedAt: Date
            + constructor(materialId, quantity, consumedAt)
        }

        ManufactureOrder "1" *-- "1..*" Stage : "composed of >"
        ManufactureOrder "1" *-- "0..*" MaterialConsumption : tracks >
        Stage "1" *-- "0..*" StagePhoto : "evidenced by >"
        Stage --> StageName : "named as"
        Stage --> StageStatus : "in state"
    }

    package "Infrastructure" as produccion_infrastructure {

        interface IProductionApi <<interface>> {
            + getByOrderId(orderId): Promise
            + planStages(orderId, stages): Promise
            + advanceStage(orderId, stageId, status): Promise
            + recordConsumption(orderId, consumption): Promise
            + uploadStagePhoto(stageId, file): Promise
        }

        class ProductionApi {
            + getByOrderId(orderId): Promise
            + planStages(orderId, stages): Promise
            + advanceStage(orderId, stageId, status): Promise
            + recordConsumption(orderId, consumption): Promise
            + uploadStagePhoto(stageId, file): Promise
        }

        class ManufactureOrderAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): ManufactureOrder
        }

        class StageAssembler <<assembler>> {
            + {static} toEntityFromResource(resource): Stage
            + {static} toEntitiesFromResponse(response): Stage[]
        }

        ProductionApi ..|> IProductionApi
    }

    package "Application" as produccion_application {

        class ProduccionStore <<store>> {
            - manufactureOrder: ManufactureOrder|null
            - stages: Stage[]
            - consumptions: MaterialConsumption[]
            + currentStage: computed
            + progressPercent: computed
            + fetchByOrderId(orderId: Number): Promise
            + planStages(orderId: Number, stages: Stage[]): Promise
            + advanceStage(orderId: Number, stageId: Number, status: StageStatus): Promise
            + recordConsumption(orderId: Number, consumption: MaterialConsumption): Promise
            + uploadStagePhoto(stageId: Number, file: File): Promise
        }

        ProduccionStore "1" --> "1" IProductionApi : consumes >
        ProduccionStore ..> ManufactureOrderAssembler : <<uses>>
        ProduccionStore ..> StageAssembler : <<uses>>
    }

    package "Presentation" as produccion_presentation {

        class ProductionBoard <<component>> {
            - store: ProduccionStore
            + advance(stageId: Number, status: StageStatus): void
        }

        class StageDetail <<component>> {
            - store: ProduccionStore
            + start(): void
            + complete(): void
            + uploadPhoto(file: File): void
        }

        class ProductionPlanForm <<component>> {
            - store: ProduccionStore
            - form: object
            + addStage(): void
            + savePlan(): void
        }

        ProductionBoard "1" --> "1" ProduccionStore : binds >
        StageDetail "1" --> "1" ProduccionStore : binds >
        ProductionPlanForm "1" --> "1" ProduccionStore : binds >
    }
}

@enduml
